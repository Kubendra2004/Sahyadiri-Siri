ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://sahyadri:password@localhost:5432/sahyadri_siri
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-random-secret
GEMINI_API_KEY=your-gemini-api-key
STORAGE_PROVIDER=firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_STORAGE_BUCKET=
AWS_S3_BUCKET=sahyadri-siri-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=*
TRUSTED_HOSTS=localhost,127.0.0.1,10.0.2.2,::1
ENABLE_API_DOCS=true
APP_PORT=8000
ADMIN_EMAIL=admin@sahyadri-siri.local
MAP_MAX_LIMIT=500
IMAGE_MAX_DIMENSION=1280
IMAGE_JPEG_QUALITY=80
IMAGE_PNG_COMPRESS_LEVEL=6
ENABLE_WEBP=false
WEBP_QUALITY=75

